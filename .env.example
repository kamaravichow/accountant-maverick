# ---- LLM (any LangChain init_chat_model id) ----
LLM_MODEL=anthropic:claude-sonnet-5
# Optional separate model for scanned-document OCR / extraction
# LLM_VISION_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # if LLM_MODEL=openai:...

# ---- Live web research (https://agent.tinyfish.ai - Search & Fetch) ----
TINYFISH_API_KEY=

# ---- Storage ----
# local | s3
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=./data/storage   # default; containers use the volume automatically
S3_BUCKET=accountant-maverick
S3_PREFIX=workspaces
# S3_REGION=ap-south-1
# Set for MinIO / Cloudflare R2 / Wasabi:
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# "path" (MinIO) / "virtual" (some managed buckets) / auto
# S3_ADDRESSING_STYLE=auto

# ---- App ----
# On Docker/Railway the entrypoint derives LOCAL_STORAGE_ROOT/CHECKPOINT_DB from the volume
# (RAILWAY_VOLUME_MOUNT_PATH or DATA_DIR=/data) unless you set them explicitly.
# Require "Authorization: Bearer <token>" on the API:
# APP_TOKEN=change-me
# Chat thread persistence: sqlite | memory
CHECKPOINTER=sqlite
# CHECKPOINT_DB=./data/checkpoints.sqlite   # default; containers use the volume automatically
CORS_ORIGINS=["http://localhost:5173"]
